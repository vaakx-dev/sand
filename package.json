{
  "name": "sand-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/core/*",
    "plugins/agent/*",
    "plugins/automation/*",
    "plugins/ui/*/*",
    "plugins/project",
    "plugins/git/*",
    "plugins/pcs/*",
    "plugins/extend/*",
    "plugins/cli/*",
    "plugins/host/*",
    "plugins/devices/*",
    "plugins/bots/*",
    "plugins/calendar/*",
    "plugins/connections/*",
    "plugins/computer/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc && bun --bun vrui-check && bun scripts/deps.ts && bun scripts/comments.ts && bun run test",
    "sand": "bun apps/sand/src/main.ts",
    "bench:computer": "bun plugins/computer/tools/bench/main.ts",
    "bench:finders": "bun plugins/computer/finders/bench/main.ts",
    "test": "bun test --parallel --timeout 20000 ./apps ./packages ./plugins",
    "test:phone": "bun test --parallel --timeout 30000 ./plugins/ui/look/kit/test/gallery/gallery.ts ./plugins/ui/shell/shell/test/phone/window.ts ./plugins/ui/shell/shell/test/phone/drawers.ts ./plugins/ui/shell/shell/test/phone/keyboard.ts ./plugins/core/features/test/web/matrix.ts ./plugins/ui/chat/chat/test/web/follow.ts ./plugins/ui/chat/chat/test/web/catch-up.ts ./plugins/core/server/test/web/hello.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "htmlparser2": "^12.0.0"
  },
  "vrui": {
    "check": [
      "apps",
      "packages",
      "plugins"
    ],
    "ui": [
      "@vaakx-dev/vrui"
    ],
    "browser": [
      "plugins/*/*/src/web/**",
      "plugins/ui/*/*/src/web/**",
      "plugins/core/web/src/boot/**",
      "plugins/core/web-client/src/**",
      "plugins/extend/plugins/src/**",
      "plugins/pcs/*/src/**",
      "plugins/devices/pcs/src/**",
      "plugins/devices/ui/src/**",
      "plugins/devices/*/src/browser/**",
      "plugins/project/src/web/**",
      "plugins/ui/shell/*/src/**",
      "plugins/ui/look/*/src/**",
      "plugins/ui/git/*/src/**",
      "plugins/ui/shared/*/src/**",
      "plugins/ui/threads/*/src/**",
      "plugins/ui/inspector/*/src/*.ts",
      "plugins/ui/panel/*/src/**",
      "plugins/ui/chat/chat/src/**",
      "plugins/ui/chat/composer/src/**",
      "plugins/ui/chat/markdown/src/**",
      "plugins/ui/chat/model-panel/src/**",
      "plugins/ui/chat/outbox/src/**",
      "plugins/ui/chat/quote/src/**",
      "plugins/ui/chat/tool-views/src/**",
      "plugins/ui/chat/transcript/src/**",
      "plugins/calendar/calendar-space/src/**"
    ],
    "roles": [
      "info",
      "orange",
      "sky",
      "violet"
    ],
    "classes": [
      "chat-row",
      "face-dot",
      "face-drift",
      "face-flip",
      "face-flop",
      "face-hop",
      "face-jitter",
      "face-look",
      "face-open",
      "face-pulse",
      "face-shut",
      "face-spin",
      "face-sway",
      "face-twinkle",
      "left"
    ],
    "shades": {
      "text-neutral": [100, 200, 400, 500, 600, 900],
      "bg-neutral": [100, 600, 700, 800, 900, 950],
      "border-neutral": [700, 800],
      "ring-neutral": [600, 700, 800]
    },
    "iconSizes": [12, 14, 16, 20]
  }
}
