{
  "name": "sand",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "vite build && npm run runtime:stage",
    "check": "tsc --noEmit && npm run runtime:stage && cargo check --manifest-path src-tauri/Cargo.toml",
    "dev": "vite",
    "runtime:stage": "bun run scripts/stageRuntime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@sand/extension-api": "0.0.1",
    "@sand/extension-runtime": "0.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui",
    "lucide": "^1.16.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
