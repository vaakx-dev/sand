{
  "name": "sand-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/core/*",
    "plugins/agent/*",
    "plugins/ui/*/*",
    "plugins/project",
    "plugins/pcs/*",
    "plugins/extend/*",
    "plugins/cli/*",
    "plugins/host/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc && bun --bun vrui-check",
    "sand": "bun apps/sand/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "htmlparser2": "^12.0.0"
  },
  "vrui": {
    "check": [
      "apps",
      "packages",
      "plugins"
    ],
    "ui": [
      "@vaakx-dev/vrui"
    ],
    "browser": [
      "plugins/*/*/src/web/**",
      "plugins/ui/*/*/src/web/**",
      "plugins/core/web/src/boot/**",
      "plugins/core/web-client/src/**",
      "plugins/extend/plugins/src/**",
      "plugins/pcs/*/src/**",
      "plugins/project/src/web/**",
      "plugins/ui/layout/*/src/**",
      "plugins/ui/look/*/src/**",
      "plugins/ui/shared/*/src/**",
      "plugins/ui/threads/*/src/**",
      "plugins/ui/chat/chat/src/**",
      "plugins/ui/chat/composer/src/**",
      "plugins/ui/chat/markdown/src/**",
      "plugins/ui/chat/model-panel/src/**",
      "plugins/ui/chat/quote/src/**",
      "plugins/ui/chat/tool-views/src/**"
    ],
    "roles": [
      "orange",
      "sky"
    ],
    "classes": [
      "left"
    ]
  }
}
