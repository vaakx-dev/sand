{
  "name": "sand-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/core/*",
    "plugins/agent/*",
    "plugins/ui/*/*",
    "plugins/projects/*",
    "plugins/pcs/*",
    "plugins/extend/*",
    "plugins/cli/*",
    "plugins/host/*",
    "plugins/browser/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc && bun --bun vrui-check",
    "sand": "bun apps/sand/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "htmlparser2": "^12.0.0"
  },
  "vrui": {
    "check": [
      "apps",
      "packages",
      "plugins"
    ],
    "ui": [
      "@vaakx-dev/vrui"
    ],
    "browser": [
      "packages/kit/src/web/**",
      "plugins/*/*/src/web/**",
      "plugins/browser/browser-panel/src/**",
      "plugins/ui/*/*/src/web/**",
      "plugins/core/web/src/boot/**",
      "plugins/core/web-client/src/**",
      "plugins/extend/plugin-changes/src/**",
      "plugins/pcs/*/src/**",
      "plugins/projects/find-files/src/**",
      "plugins/projects/new-project/src/**",
      "plugins/ui/layout/*/src/**",
      "plugins/ui/look/*/src/**",
      "plugins/ui/shared/*/src/**",
      "plugins/ui/thread/composer-card/src/**",
      "plugins/ui/thread/context-ring/src/**",
      "plugins/ui/thread/image-viewer/src/**",
      "plugins/ui/thread/markdown/src/**",
      "plugins/ui/thread/model-panel/src/**",
      "plugins/ui/thread/panel-agents/src/**",
      "plugins/ui/thread/quote-reply/src/**",
      "plugins/ui/thread/transcript-chat/src/**",
      "plugins/ui/thread/transcript-log/src/**",
      "plugins/ui/thread/transcript-parts/src/**",
      "plugins/ui/thread/view-edit/src/**",
      "plugins/ui/thread/view-grep/src/**",
      "plugins/ui/thread/view-read/src/**",
      "plugins/ui/thread/view-shell/src/**"
    ],
    "roles": [
      "orange",
      "sky"
    ],
    "classes": [
      "left"
    ]
  }
}
