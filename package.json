{
  "name": "sand-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/core/*",
    "plugins/agent/*",
    "plugins/ui/*/*",
    "plugins/projects/*",
    "plugins/pcs/*",
    "plugins/extend/*",
    "plugins/cli/*",
    "plugins/host/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc && bun --bun vrui-check",
    "sand": "bun apps/sand/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.3",
    "typescript": "^7.0.2"
  },
  "vrui": {
    "check": [
      "apps",
      "packages",
      "plugins"
    ],
    "ui": [
      "@vaakx-dev/vrui",
      "@sand/dom"
    ],
    "browser": [
      "packages/dom/src/**",
      "plugins/*/*/src/web/**",
      "plugins/ui/*/*/src/web/**",
      "plugins/core/web/src/boot/**",
      "plugins/core/web-client/src/**",
      "plugins/extend/plugin-changes/src/**",
      "plugins/pcs/*/src/**",
      "plugins/projects/find-files/src/**",
      "plugins/projects/new-project/src/**",
      "plugins/ui/layout/*/src/**",
      "plugins/ui/shared/*/src/**",
      "plugins/ui/thread/composer-card/src/**",
      "plugins/ui/thread/context-ring/src/**",
      "plugins/ui/thread/markdown/src/**",
      "plugins/ui/thread/model-panel/src/**",
      "plugins/ui/thread/panel-agents/src/**",
      "plugins/ui/thread/transcript-chat/src/**",
      "plugins/ui/thread/transcript-log/src/**",
      "plugins/ui/thread/transcript-parts/src/**",
      "plugins/ui/thread/view-edit/src/**",
      "plugins/ui/thread/view-grep/src/**",
      "plugins/ui/thread/view-read/src/**",
      "plugins/ui/thread/view-shell/src/**"
    ],
    "roles": [
      "orange",
      "sky"
    ],
    "classes": [
      "animate-drawer",
      "animate-fade",
      "animate-pop",
      "animate-rise",
      "animate-slide",
      "animate-tip",
      "ask-own",
      "cc-dock",
      "cc-drop",
      "cc-glass",
    "cc-tray",
      "left",
      "live-shine",
      "markdown",
      "prose",
      "spinner",
      "spinner-still",
      "spinner-turn",
      "text-middle",
      "touch-current:flex",
      "transcript-chat-bubble",
      "transcript-chat-copy",
      "transcript-chat-rail",
      "transcript-chat-streaming"
    ]
  }
}
