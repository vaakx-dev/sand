{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sand",
  "version": "0.0.1",
  "identifier": "works.sand.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sand",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/runtime/runtime/": "runtime/",
      "../build/runtime/extensions/": "extensions/",
      "../build/runtime/node_modules/": "node_modules/"
    }
  }
}
