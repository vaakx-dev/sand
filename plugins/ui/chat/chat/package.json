{
  "name": "@sand/chat",
  "version": "0.0.0",
  "description": "The thread chat: a thread transcript with \"Worked for\" turns, branches, queued messages and scrolling that keeps your place",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "threads",
    "web": "./src/index.ts",
    "label": "Chat",
    "summary": "Messages with markdown, and tool steps grouped under each reply"
  },
  "dependencies": {
    "@sand/changes": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/composer": "workspace:*",
    "@sand/markdown": "workspace:*",
    "@sand/picker": "workspace:*",
    "@sand/reactive": "workspace:*",
    "@sand/transcript": "workspace:*",
    "@sand/turns-contract": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/ui-shell": "workspace:*",
    "@sand/util": "workspace:*",
    "@sand/web-client": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.9",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "@sand/model-panel": "workspace:*"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
