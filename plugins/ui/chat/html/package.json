{
  "name": "@sand/html",
  "version": "0.0.0",
  "description": "html_render and html_preview: the agent shows HTML pages inline in the chat, in the app theme, and checks them in a headless browser first",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "html",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "HTML pages",
    "summary": "Shows pages the agent builds, like charts, tables and mockups, inline in the chat"
  },
  "dependencies": {
    "@sand/cdp": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/config": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/images": "workspace:*",
    "@sand/keys": "workspace:*",
    "@sand/media": "workspace:*",
    "@sand/prompt": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/skills": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/transcript": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/ui-shell": "workspace:*",
    "@sand/ui-theme": "workspace:*",
    "@sand/util": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.10",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/harness": "workspace:*"
  }
}
