{
  "name": "@sand/transcript-parts",
  "version": "0.0.0",
  "description": "Shared pieces for transcripts and tool views: thread items, tool cards, renderer registry",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "web": "./src/index.ts",
