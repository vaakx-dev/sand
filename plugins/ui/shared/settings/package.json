{
  "name": "@sand/settings",
  "version": "0.0.0",
  "description": "Settings: the sidebar lists the settings pages and the main column shows the chosen one",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "web": "./src/index.ts",
    "label": "Settings",
    "summary": "The settings pages",
    "provides": [
      "settings"
    ],
    "uses": {
      "layout": "settings cover the whole window",
      "nav": "no Settings button in the sidebar",
      "sidebar": "a floating Settings button shows when there is no /settings command either",
      "commands": "no /settings command"
    }
  },
  "dependencies": {
    "@sand/kit": "workspace:*",
    "@sand/nav": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1"
  }
}
