{
  "name": "@sand/file-documents",
  "version": "0.0.0",
  "description": "Shows OpenDocument, EPUB and rich text files in the file viewer",
  "type": "module",
  "sand": {
    "feature": "file-documents",
    "web": "./src/web/index.ts",
    "label": "Documents",
