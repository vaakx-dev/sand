{
  "name": "@sand/file-images",
  "version": "0.0.0",
  "description": "Shows TIFF images in the file viewer, decoded in the page",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "file-images",
    "runtime": "./src/runtime/index.ts",
    "web": "./src/web/index.ts",
    "label": "More images",
    "summary": "TIFF images",
    "features": {
      "file-images": {
        "label": "More images",
        "summary": "TIFF images",
        "parent": "file-viewer",
        "addon": true
      }
    }
  },
  "dependencies": {
    "@sand/file-viewer": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/util": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.11",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "utif2": "^4.1.0"
  }
}
