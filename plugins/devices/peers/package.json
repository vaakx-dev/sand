{
  "name": "@sand/devices-peers",
  "version": "0.0.0",
  "description": "Keeps this PC connected to each of your other PCs, shares the device list with them and forwards connections through this PC",
  "type": "module",
  "sand": {
    "feature": "pcs",
    "host": "./src/host.ts",
    "runtime": "./src/runtime.ts",
    "label": "Your PCs",
    "summary": "Connections to your other PCs",
    "features": {
      "pcs": {
        "label": "Several PCs",
        "summary": "Use sand on your other PCs from one place, with your plugins shared between them",
        "needs": [
          "phone"
        ],
        "addon": true
      },
      "ssh": {
        "label": "SSH machines",
        "summary": "Use machines you reach over SSH as your PCs, and set sand up on them",
        "parent": "pcs"
      }
    }
  },
  "dependencies": {
    "@sand/devices-connect": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-daemon": "workspace:*",
    "@sand/host-gateway": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/host-runtimes": "workspace:*",
    "@sand/media": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/devices-identity": "workspace:*"
  }
}
