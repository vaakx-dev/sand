{
  "name": "@sand/bot-turns",
  "version": "0.0.0",
  "description": "Runs each bot's turns on the shared engine: its jobs as instructions, its main model, its conversation as the history",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "bots",
    "runtime": "./src/index.ts",
    "label": "Bot turns",
    "summary": "Lets your bots answer: runs their turns with their jobs and model"
  },
  "dependencies": {
    "@sand/accounts": "workspace:*",
    "@sand/bots": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/context": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/orchestrator": "workspace:*",
    "@sand/project": "workspace:*",
    "@sand/prompt": "workspace:*",
    "@sand/provider-threads": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/bot-memory": "workspace:*",
    "@sand/compaction": "workspace:*",
    "@sand/devices-notify": "workspace:*",
    "@sand/harness": "workspace:*",
    "@sand/ledger": "workspace:*",
    "@sand/media": "workspace:*",
    "@sand/memory": "workspace:*",
    "@sand/replay": "workspace:*"
  }
}
