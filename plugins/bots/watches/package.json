{
  "name": "@sand/bot-watches",
  "version": "0.0.0",
  "description": "Bots that listen: a bot follows a page, a folder, a webhook or a repo through a cheap watcher, and wakes in its own conversation only when something changed",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "bot-watches",
    "runtime": "./src/runtime/index.ts",
    "host": "./src/index.ts",
    "cli": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Bot watches",
    "summary": "Lets your bots listen to pages, folders, webhooks and repos, and wake only when something changed"
  },
  "dependencies": {
    "@sand/bot-turns": "workspace:*",
    "@sand/bots": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/mcp-server": "workspace:*",
    "@sand/orchestrator": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/transcript": "workspace:*",
    "@sand/util": "workspace:*",
    "@sand/watches": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/engine": "workspace:*",
    "@sand/harness": "workspace:*",
    "@sand/replay": "workspace:*",
    "@sand/tools": "workspace:*"
  }
}
