{
  "name": "@sand/host-plugin-sync",
  "version": "0.0.0",
  "description": "Shares ~/.sand/plugins with paired PCs, asking before applying changes",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "label": "Plugin sync",
    "summary": "Shares your plugins with paired PCs",
    "provides": [
      "hostPluginSync"
    ]
  },
  "dependencies": {
    "@sand/host-hub": "workspace:*",
    "@sand/host-plugin-versions": "workspace:*",
    "@sand/host-remotes": "workspace:*",
    "@sand/kit": "workspace:*",
    "@sand/protocol": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1"
  }
}
