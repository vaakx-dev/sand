{
  "name": "@sand/host-plugin-sync",
  "version": "0.0.0",
  "description": "Shares ~/.sand/plugins with paired PCs, asking before applying changes",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "host": "./src/index.ts",
    "label": "Plugin sync",
