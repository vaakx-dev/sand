  "dependencies": {
    "@sand/host-daemon": "workspace:*",
    "@sand/host-devices": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/host-plugin-library": "workspace:*",
    "@sand/host-plugin-versions": "workspace:*",
    "@sand/host-remotes": "workspace:*",
    "@sand/host-runtimes": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
