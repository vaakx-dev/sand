{
  "name": "@sand/host-runtimes",
  "version": "0.0.0",
  "description": "Starts sand runtimes, swaps in fresh ones and restarts them when they crash",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "label": "Runtimes",
    "summary": "Starts and swaps sand runtimes",
    "provides": [
      "runtimes"
    ]
  },
  "dependencies": {
    "@sand/kit": "workspace:*",
    "@sand/protocol": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1"
  }
}
