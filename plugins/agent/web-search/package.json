{
  "name": "@sand/web-search",
  "version": "0.0.0",
  "description": "web_search and web_fetch tools and the web sub-agent that uses them, plus their views in the thread",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sand": {
    "web": "./src/web/index.ts",
    "label": "Web search views",
    "summary": "Shows what the web agent searched for and which pages it read",
    "uses": {
      "transcript": "web calls use the generic tool view"
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@sand/agents": "workspace:*",
    "@sand/browser-engine": "workspace:*",
    "@sand/kit": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/transcript-parts": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6"
  }
}
