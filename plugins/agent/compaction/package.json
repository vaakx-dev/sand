{
  "name": "@sand/compaction",
  "version": "0.0.0",
  "description": "Compacts a conversation into a summary when its context fills up or an active thread sits idle until its prompt cache is about to expire, and reports context usage",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "compaction",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "label": "Compaction",
    "summary": "Summarizes a long chat before their context fills up"
  },
  "dependencies": {
    "@sand/accounts": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/media": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/provider-threads": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/turns-contract": "workspace:*",
    "@sand/usage": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
