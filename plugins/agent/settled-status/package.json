{
  "name": "@sand/settled-status",
  "version": "0.0.0",
  "description": "When a thread settles, the sub model writes one line on where it ended, shown on its sidebar row",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "threads",
    "runtime": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Settled status",
    "summary": "One line on where each settled thread ended"
  },
  "dependencies": {
    "@sand/chats": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/sidebar": "workspace:*",
    "@sand/sub-model": "workspace:*",
    "@sand/util": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.8",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
