{
  "name": "@sand/permissions",
  "version": "0.0.0",
  "description": "Permission modes for threads and bots: off, ask and auto, with saved rules, questions with a deadline, stricter defaults for threads a bot starts and a log of every decision",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "permissions",
    "runtime": "./src/index.ts",
    "cli": "./src/cli.ts",
    "label": "Permissions",
    "summary": "Asks you, or a reviewer model, before an agent runs commands, sends, spends or deletes",
    "features": {
      "permissions": {
        "label": "Permissions",
        "summary": "Threads and bots ask you, or a reviewer model, before risky calls",
        "needs": [
          "engine"
        ],
        "addon": true
      }
    }
  },
  "dependencies": {
    "@sand/bots": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/cli-commands": "workspace:*",
    "@sand/devices-notify": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/host-daemon": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/host-runtimes": "workspace:*",
    "@sand/ledger": "workspace:*",
    "@sand/orchestrator": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/sub-model": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/harness": "workspace:*",
    "@sand/replay": "workspace:*"
  }
}
