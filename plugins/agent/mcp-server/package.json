{
  "name": "@sand/mcp-server",
  "version": "0.0.0",
  "description": "sand as an MCP server for outside agents: the sand mcp command on stdio and /mcp over HTTP for paired agents, serving the tools other features register",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "mcp-server",
    "host": "./src/http/index.ts",
    "cli": "./src/stdio.ts",
    "label": "MCP server",
    "summary": "Lets outside agents reach sand over MCP, with the sand mcp command or at /mcp for agents paired in Settings → Devices"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@sand/cli-commands": "workspace:*",
    "@sand/config": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-daemon": "workspace:*",
    "@sand/host-gateway": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/orchestrator": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@sand/harness": "workspace:*"
  }
}
