  "description": "MCP client: the agent uses the tools of the user's own MCP servers set in sand.toml, with a settings page showing each server's state",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "mcp",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
