{
  "name": "@sand/sub-model",
  "version": "0.0.0",
  "description": "A small, cheap model for background jobs such as commit messages and branch names, with a skill per job",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "background",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Sub model",
    "summary": "The model other plugins use for background jobs, and the skill each job follows"
  },
  "dependencies": {
    "@sand/ask": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/model-panel": "workspace:*",
    "@sand/model-picker": "workspace:*",
    "@sand/nav": "workspace:*",
    "@sand/paths": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/skills": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/util": "workspace:*",
    "@sand/web-client": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.8",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
