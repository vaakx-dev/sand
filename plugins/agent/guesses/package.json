{
  "name": "@sand/guesses",
  "version": "0.0.0",
  "description": "Guesses the next message after each turn of a thread or bot chat, with the chat's own model and prompt cache, for the composer to offer",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "guesses",
    "runtime": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Next message guesses",
    "summary": "Offers a likely next message in the empty composer after each reply",
    "features": {
      "guesses": {
        "label": "Message guesses",
        "summary": "Offers a likely next message in the empty composer after each reply",
        "needs": [
          "engine",
          "composer"
        ],
        "addon": true
      }
    }
  },
  "dependencies": {
    "@sand/accounts": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/composer": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/provider-threads": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/usage": "workspace:*",
    "@sand/util": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.10",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/harness": "workspace:*",
    "@sand/replay": "workspace:*"
  }
}
