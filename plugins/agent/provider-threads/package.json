{
  "name": "@sand/provider-threads",
  "version": "0.0.0",
  "description": "Keeps what each model of a chat has seen, so a model keeps its cached prefix and a switch hands over only what fits",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "engine",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "label": "Provider threads",
    "summary": "What each model of a chat has seen, so switching models keeps caches warm",
    "web": "./src/web/index.ts"
  },
  "dependencies": {
    "@sand/accounts": "workspace:*",
    "@sand/chats": "workspace:*",
    "@sand/compaction": "workspace:*",
    "@sand/engine": "workspace:*",
    "@sand/ledger": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/transcript": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/web-client": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.8",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/harness": "workspace:*",
    "@sand/replay": "workspace:*"
  }
}
