{
  "name": "@sand/jobs",
  "version": "0.0.0",
  "description": "Background jobs: sub-agents that run on after the tool call returns",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Background jobs",
    "summary": "Tracks background agents, tells the agent when they finish, and lets it read, message, wait for and stop them"
  },
  "dependencies": {
    "@sand/chats": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/loop": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/steering": "workspace:*",
    "@sand/tools": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
