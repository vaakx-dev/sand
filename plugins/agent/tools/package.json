{
  "name": "@sand/tools",
  "version": "0.0.0",
  "description": "Tool registry and catalog: tools register here, the loop runs them, and on-demand groups load through find_tools",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "web": "./src/web/index.ts",
    "label": "Tools",
    "summary": "The Tools settings page, and the tools the agent found in a thread",
    "provides": [
      "tools"
    ],
    "uses": {
      "settings": "no Tools settings page",
      "transcript": "find_tools calls use the generic tool view",
      "notify": "failed changes are not reported"
    }
  },
  "dependencies": {
    "@sand/dom": "workspace:*",
    "@sand/kit": "workspace:*",
    "@sand/llm-accounts": "workspace:*",
    "@sand/messages": "workspace:*",
    "@sand/paths": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/sessions-sqlite": "workspace:*",
    "@sand/settings": "workspace:*",
    "@sand/transcript-parts": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1",
    "zod": "^4.6.5"
  }
}
