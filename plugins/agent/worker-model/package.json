{
  "name": "@sand/worker-model",
  "version": "0.0.0",
  "description": "The worker model: the model, effort and speed that worker sub-agents like browser and web run on",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "web": "./src/web/index.ts",
    "label": "Worker model",
    "summary": "One model picker under Settings → Models for the agents that do mechanical work",
    "provides": [
      "workerModel"
    ],
    "uses": {
      "server": "the settings page cannot read or save the worker model",
      "settings": "no Worker model section",
      "modelPicker": "no worker model picker",
      "notify": "failed saves are not reported"
    }
  },
  "dependencies": {
    "@sand/kit": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/model-picker": "workspace:*",
    "@sand/paths": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/settings": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/web-client": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1"
  }
}
