{
  "name": "@sand/turns",
  "version": "0.0.0",
  "description": "Runs each chat's turns on the engine and serves them to pages: send, steer, queue, interrupt and follow turns",
  "type": "module",
  "sand": {
    "feature": "threads",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "label": "Turns",
