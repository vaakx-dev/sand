{
  "name": "@sand/command-keeper",
  "version": "0.0.0",
  "description": "Holds background commands in a keeper process that outlives sand's restarts and updates",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "feature": "shell",
    "host": "./src/host/index.ts",
    "label": "Background command keeper",
    "summary": "Keeps background commands running through sand restarts and updates"
  },
  "dependencies": {
    "@sand/config": "workspace:*",
    "@sand/host-daemon": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/host-runtimes": "workspace:*",
    "@sand/process-tree": "workspace:*",
    "@sand/util": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sand/chats": "workspace:*",
    "@sand/harness": "workspace:*",
    "@sand/jobs": "workspace:*",
    "@sand/tools": "workspace:*"
  }
}
