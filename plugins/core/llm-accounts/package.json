{
  "name": "@sand/llm-accounts",
  "version": "0.0.0",
  "description": "Use Anthropic, OpenAI and OpenRouter API keys, local servers, and sign-in plans that other plugins add, all at once",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts"
  },
  "sand": {
    "label": "Accounts",
    "summary": "API keys, local servers and sign-in plans from other plugins",
    "provides": [
      "llm"
    ],
    "web": "./src/web/index.ts"
  },
  "dependencies": {
    "@sand/host-remotes": "workspace:*",
    "@sand/kit": "workspace:*",
    "@sand/messages": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/sessions-sqlite": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.6",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1",
    "zod": "^4.6.5"
  }
}
