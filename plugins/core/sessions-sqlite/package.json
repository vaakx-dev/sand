{
  "name": "@sand/sessions-sqlite",
  "version": "0.0.0",
  "description": "Stores threads in SQLite",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "label": "Thread store",
    "summary": "Keeps threads in a SQLite database",
    "provides": [
      "sessions"
    ],
    "uses": {
      "server": "the page gets no thread metadata such as pins"
    }
  },
  "dependencies": {
    "@sand/kit": "workspace:*",
    "@sand/messages": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/paths": "workspace:*",
    "@sand/project-files": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/server": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1",
    "zod": "^4.6.5"
  }
}
