{
  "name": "@sand/ui-headless",
  "version": "0.0.0",
  "description": "sand -p: a minimal test runner that runs one prompt or /command without a server and prints the reply",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sand": {
    "label": "Headless",
    "summary": "Test runner: one prompt or /command, printed in the terminal",
    "provides": [
      "ui"
    ],
    "uses": {
      "llm": "no plan limits in the summary",
      "modelSettings": "ignores --model, --effort and --fast"
    }
  },
  "dependencies": {
    "@sand/agents": "workspace:*",
    "@sand/compaction": "workspace:*",
    "@sand/html-render": "workspace:*",
    "@sand/kit": "workspace:*",
    "@sand/llm-accounts": "workspace:*",
    "@sand/loops": "workspace:*",
    "@sand/messages": "workspace:*",
    "@sand/model": "workspace:*",
    "@sand/protocol": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/sessions-sqlite": "workspace:*",
    "drydock": "github:vaakx-dev/drydock#v0.1.0-alpha.1"
  }
}
