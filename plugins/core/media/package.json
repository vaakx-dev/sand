{
  "name": "@sand/media",
  "version": "0.0.0",
  "description": "Keeps every image and document a chat uses in one store on disk, and serves them to the page through signed links",
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts",
    "./web/contract": "./src/web/contract.ts"
  },
  "sand": {
    "feature": "media",
    "runtime": "./src/index.ts",
    "print": "./src/index.ts",
    "web": "./src/web/index.ts",
    "label": "Media",
    "summary": "Stores the images and documents in chats and shows them in the page"
  },
  "dependencies": {
    "@sand/chats": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/paths": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/ui-kit": "workspace:*",
    "@sand/util": "workspace:*",
    "@sand/web-client": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.9",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
