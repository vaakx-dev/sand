{
  "name": "@sand/web",
  "version": "0.0.0",
  "description": "Serves the browser UI: bundles the web extensions and hands them to the page",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "sand": {
    "runtime": "./src/index.ts",
    "label": "Web",
    "summary": "Builds the page from the web extensions"
  },
  "dependencies": {
    "@sand/config": "workspace:*",
    "@sand/devices-contract": "workspace:*",
    "@sand/devices-identity": "workspace:*",
    "@sand/host-hub": "workspace:*",
    "@sand/host-runtimes": "workspace:*",
    "@sand/server": "workspace:*",
    "@sand/ui-theme": "workspace:*",
    "@sand/util": "workspace:*",
    "@vaakx-dev/vrui": "github:vaakx-dev/vrui#v0.1.0-alpha.8",
    "drydock": "github:vaakx-dev/drydock#v0.2.0-alpha.1",
    "zod": "^4.6.5"
  }
}
